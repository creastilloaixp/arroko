{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "App.tsx",
    "index.tsx",
    "api/**/*.ts",
    "components/**/*.tsx",
    "context/**/*.tsx",
    "lib/**/*.ts",
    "pages/**/*.tsx",
    "types/**/*.ts",
    "supabase.ts",
    "types.ts",
    "env.d.ts"
  ],
  "exclude": ["node_modules", "dist", "supabase/functions"]
}
