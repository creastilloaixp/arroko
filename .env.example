# ==============================================================================
# ARROKÓ SUSHI PLATFORM - VARIABLES DE ENTORNO Y SECRETOS (PLANTILLA OFICIAL)
# ==============================================================================
# IMPORTANTE: 
# 1. Copia este archivo como '.env' en local o configura estas variables en Vercel/Supabase.
# 2. NUNCA subas archivos .env con valores reales a repositorios públicos o compartidos.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / CLIENTE (Vite - Variables Públicas en el Navegador)
# ------------------------------------------------------------------------------
# URL del proyecto Supabase de Arrokó
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave anónima pública de Supabase (safe for browser)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Endpoint público para la experiencia de comensal (Check-in, Ruleta, ArroKids)
VITE_ARROKO_EXPERIENCE_URL=https://tu-proyecto.supabase.co/functions/v1/arroko-public-experience

# Configuración opcional de automatización n8n
VITE_N8N_WEBHOOK_URL=https://n8n.tu-dominio.com/webhook/arroko
VITE_N8N_WORKFLOW_ID=arroko-automation


# ------------------------------------------------------------------------------
# 2. SUPABASE BACKEND & EDGE FUNCTIONS (Secretos de Servidor - Nivel Alto)
# ------------------------------------------------------------------------------
# URL interna y Service Role Key (BYPASS DE RLS - MÁXIMO PRIVILEGIO)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.SERVICE_ROLE_AQUI...

# Llave de cifrado simétrico AES-256 para la Bóveda Segura de PII (Teléfonos reales)
ARROKO_PII_ENCRYPTION_KEY=tu_clave_secreta_hex_de_32_bytes_para_cifrado

# Secreto compartido HMAC para firma de webhooks de ingesta de datos
ARROKO_INGEST_SECRET=tu_secreto_hmac_para_firmar_ingesta_pos

# Dominios autorizados para CORS en Edge Functions (separados por coma)
ARROKO_PUBLIC_ORIGINS=https://arroko.creastilo-ai-xperience.com,https://tu-dominio.com


# ------------------------------------------------------------------------------
# 3. SOFT RESTAURANT (POS / Punto de Venta)
# ------------------------------------------------------------------------------
# Identificador del tenant o restaurante asignado
SOFTRESTAURANT_ORG_ID=arroko-matriz-01

# Endpoint del servicio NSDeveloper o Bridge local del servidor Windows
SOFTRESTAURANT_API_URL=https://api.softrestaurant.com.mx/v1
# SOFTRESTAURANT_API_URL=http://192.168.1.50:8080/wrestaurant/api

# Token de aplicación autorizada (header AuthorizedApp)
SOFTRESTAURANT_API_KEY=tu_api_key_de_soft_restaurant

# Secreto de webhook para recepción de ventas/tickets desde Soft Restaurant
SOFTRESTAURANT_WEBHOOK_SECRET=tu_secreto_de_firma_webhook_pos

# Conexión directa SQL Server (Solo si se usa Bridge de contingencia de solo lectura)
# SOFTRESTAURANT_SQL_HOST=192.168.1.50
# SOFTRESTAURANT_SQL_DATABASE=SoftRestaurant11
# SOFTRESTAURANT_SQL_USER=read_only_bridge
# SOFTRESTAURANT_SQL_PASSWORD=password_seguro


# ------------------------------------------------------------------------------
# 4. META FOR BUSINESS / WHATSAPP CLOUD API / EVOLUTION API
# ------------------------------------------------------------------------------
# URL base de Evolution API (si se usa host propio en VPS/Hostinger)
EVOLUTION_API_URL=https://evolution.tu-dominio.com

# API Key global de Evolution API
EVOLUTION_API_KEY=tu_global_api_key_evolution

# Nombre de la instancia activa de WhatsApp en Evolution API
EVOLUTION_INSTANCE=arroko_sushi_oficial

# Meta Business / WhatsApp Cloud API oficial (si se migra a Cloud API directa)
META_APP_ID=tu_meta_app_id
META_APP_SECRET=tu_meta_app_secret
META_WHATSAPP_TOKEN=EAAG...tu_token_de_acceso_permanente
META_PHONE_NUMBER_ID=tu_phone_number_id
META_WEBHOOK_VERIFY_TOKEN=token_secreto_personalizado_para_verificar_webhook


# ------------------------------------------------------------------------------
# 5. INTELIGENCIA ARTIFICIAL (Sommelier & WhatsApp Agent)
# ------------------------------------------------------------------------------
# Llave de Google Gemini (utilizado por el Sommelier y el webhook de WhatsApp)
GEMINI_API_KEY=AIzaSy...tu_gemini_api_key
# API_KEY=AIzaSy...tu_gemini_api_key (usado internamente por Edge Functions)


# ------------------------------------------------------------------------------
# 6. INFRAESTRUCTURA HOSTINGER / VPS / DOMINIOS
# ------------------------------------------------------------------------------
# Credenciales de API de Hostinger (para gestión de DNS o despliegue automatizado)
HOSTINGER_API_TOKEN=tu_token_api_hostinger

# Servidor SMTP de correo transaccional (Hostinger Mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contacto@tu-dominio.com
SMTP_PASSWORD=tu_password_de_correo_hostinger
SMTP_FROM_EMAIL=notificaciones@tu-dominio.com